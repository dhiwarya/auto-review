# Optional. A fine-grained GitHub token limited to the repos in repos.allow, with:
#   Contents: read, Pull requests: read & write, Issues: read & write, Metadata: read
# Leave unset to use your GitHub CLI login (gh auth login) instead.
GITHUB_TOKEN=

# Optional. Only needed when the machine can't use your normal Claude login
# (for example a headless Linux box). Create one with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Optional. Everything else is set on the dashboard's Settings page.
# PORT=4477
# DATA_DIR=./data
