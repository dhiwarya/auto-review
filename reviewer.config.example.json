{
  "repos": {
    "allow": ["your-org/*", "your-username/some-repo"],
    "deny": []
  },
  "dryRun": true,
  "defaultMode": "draft",
  "repoModes": {},
  "models": {
    "provider": "codex",
    "fallbackToOther": true,
    "doubleCheck": true,
    "codex": { "model": "gpt-6.1-sol", "fallbackModels": ["gpt-6-sol"] },
    "claude": { "model": "claude-opus-5-5", "fallbackModels": ["claude-opus-4-8"] },
    "claudeEffort": null
  },
  "schedule": {
    "pollIntervalSec": 5,
    "syncIntervalSec": 60,
    "maxReviewsPerHour": 6,
    "concurrency": 1,
    "pauseBetween": null,
    "quotaBackoffMin": 30
  },
  "limits": {
    "largePrLines": 1500,
    "maxDiffChars": 200000,
    "maxNits": 5,
    "passTimeoutSec": 900,
    "claudeMaxTurns": 60,
    "maxAttempts": 3
  },
  "labels": {
    "prefix": "ai-review",
    "blockerLabelInDraft": false
  },
  "server": { "host": "127.0.0.1", "port": 4477 },
  "dataDir": "./data"
}
