{
  "name": "auto-reviewer",
  "version": "0.1.0",
  "private": true,
  "description": "Personal PR review agent: reviews PRs that request you, using your own Claude Code and Codex logins, with a local dashboard.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "cross-spawn": "^7.0.6",
    "fastify": "^5.12.7",
    "octokit": "^5.0.5",
    "picomatch": "^4.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
